# 服务端口
PORT=3000

# SQLite 数据库文件路径（相对 apps/server 运行目录）
DATABASE_PATH=./data.db

# 用户显示名（单用户应用）
USER_NAME=我

# ---- 飞书应用（开放平台 https://open.feishu.cn 创建自建应用）----
# 事件订阅使用「长连接」模式，无需公网回调地址。
# 需要权限：im:message（接收）、im:message:send_as_bot（发送）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---- DeepSeek（https://platform.deepseek.com，文档 https://api-docs.deepseek.com/zh-cn/）----
# 未配置时消息解析降级为内置正则，AI 周报不可用
# 模型：deepseek-v4-flash（默认）/ deepseek-v4-pro；旧的 deepseek-chat 将于 2026-07-24 弃用
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 每日提醒时间（cron 分 时，默认 21:00）；留空关闭提醒
REMIND_CRON=0 21 * * *
# 每周报告时间（默认周一 09:00）；留空关闭周报
REPORT_CRON=0 9 * * 1
